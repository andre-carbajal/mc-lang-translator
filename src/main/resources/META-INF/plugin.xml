<idea-plugin>
    <id>net.andrecarbajal.mclangtranslator</id>
    <name>MC Lang Translator</name>
    <vendor>Andre Carbajal</vendor>
    <description><![CDATA[
        <p>Translate Minecraft mod language JSON files with Google Translate, DeepL, Microsoft Translator, or OpenAI-compatible AI APIs.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="net.andrecarbajal.mclangtranslator.state.McTranslatorStateService"/>
        <applicationService serviceImplementation="net.andrecarbajal.mclangtranslator.cache.ProviderLanguageCache"/>
        <notificationGroup id="MC Lang Translator" displayType="BALLOON"/>
        <applicationConfigurable
                parentId="tools"
                instance="net.andrecarbajal.mclangtranslator.ui.SettingsConfigurable"
                id="net.andrecarbajal.mclangtranslator.settings"
                displayName="MC Lang Translator"/>
    </extensions>

    <actions>
        <action
                id="McLangTranslator.TranslateLangFile"
                class="net.andrecarbajal.mclangtranslator.actions.TranslateLangFileAction"
                text="Translate lang file..."
                description="Translate this Minecraft lang JSON to other languages">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
